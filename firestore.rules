rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya user yang sudah login (Firebase Auth) yang bisa akses data.
    // Karena ini app single-admin, cukup cek request.auth != null.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
